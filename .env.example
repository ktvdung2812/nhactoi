# Nhắc tôi · Next.js full stack · Node.js >= 24
# Copy this file to .env. Never commit credentials.
PORT=3000
# PostgreSQL 15+; create the database before starting the app.
DATABASE_URL=postgresql://nhactoi:change-me@127.0.0.1:5432/nhactoi
# Persistent uploads, snapshots and settings encryption key (separate from PostgreSQL).
NHACTOI_DATA_DIR=./data
# Migration/startup creates an admin only when no active SaaS admin exists.
# Optional: defaults to Admin SaaS / admin@nhactoi.local. Existing users are never promoted.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
# 12–200 characters. Empty = random password saved to data/bootstrap-admin-user_*.json (0600).
BOOTSTRAP_ADMIN_PASSWORD=
PUBLIC_APP_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://nhactoi.test
# Enable for HTTPS-only environments; production enables Secure cookies automatically.
COOKIE_SECURE=false
# Local development only: shows the demo quick-login accounts on the login page.
# Ignored when NODE_ENV=production. Leave unset on any shared or public server.
NHACTOI_DEV_LOGIN=true

# BillGateway Payment Hub: origin, without /api/v1 suffix.
# Project API key starts bg_proj_; do not use a bank transaction bg_live_ key.
BILLGATE_API_URL=
BILLGATE_API_KEY=
BILLGATE_WEBHOOK_SECRET=
BILLGATE_PROJECT_ID=

# Admin settings saved in the database override these defaults.
# Optional persistent encryption key: exactly 32 random bytes as 64 hex chars or
# base64 (openssl rand -hex 32); passphrases are rejected. Or point to a key file.
# Upgrading from a passphrase: use its SHA-256 hex digest
# (printf %s '<passphrase>' | shasum -a 256) so saved secrets stay readable.
# When omitted, data/.nhactoi-settings.key is generated with mode 0600.
# The same key encrypts admin secrets and database backups.
# Back up that key with the database; never commit it.
NHACTOI_SETTINGS_KEY=
NHACTOI_SETTINGS_KEY_FILE=

# Illustrative pricing, VND. Annual values are the TOTAL for 12 months.
STARTER_MONTHLY_PRICE=199000
STARTER_YEARLY_PRICE=1990000
TEAM_MONTHLY_PRICE=499000
TEAM_YEARLY_PRICE=4990000
BUSINESS_MONTHLY_PRICE=999000
BUSINESS_YEARLY_PRICE=9990000

# Server checks scheduled reminders every 30 seconds.
REMINDER_INTERVAL_MS=30000
# Android push through FCM HTTP v1. Optional; keep service-account credentials server-side.
# JSON contents of a Firebase service account, supplied through the deployment secret store.
FCM_SERVICE_ACCOUNT_JSON=
# Or use the following three values instead of JSON (private key accepts literal \n).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Set true only for isolated API tests or a secondary instance without job timers.
DISABLE_BACKGROUND_WORKER=false
# SMTP is required for password recovery emails; leave empty for in-app reminders only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional AI chat. SaaS admin settings override these defaults.
# Provider: openrouter or anthropic; use a model that supports tools.
AI_ENABLED=false
AI_PROVIDER=openrouter
AI_MODEL=anthropic/claude-sonnet-4
AI_API_KEY=

# Optional browser Web Push (VAPID). Generate once: npm run web-push:keys
# Keep PRIVATE_KEY server-side and stable across deploys. HTTPS required outside localhost.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
