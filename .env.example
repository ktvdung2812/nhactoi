# Nhắc tôi · Node.js >= 24
# Copy this file to .env. Never commit credentials.
PORT=3100
HOST=127.0.0.1
DATABASE_PATH=./data/nhactoi.sqlite
PUBLIC_APP_URL=https://nhactoi.test
FRONTEND_ORIGIN=https://nhactoi.test,http://nhactoi.test,http://127.0.0.1:5170,http://localhost:5170,http://127.0.0.1:5173,http://localhost:5173
# Enable for HTTPS-only environments; production enables Secure cookies automatically.
COOKIE_SECURE=false

# BillGateway Payment Hub: origin, without /api/v1 suffix.
# Project API key starts bg_proj_; do not use a bank transaction bg_live_ key.
BILLGATE_API_URL=
BILLGATE_API_KEY=
BILLGATE_WEBHOOK_SECRET=
BILLGATE_PROJECT_ID=

# Admin settings saved in the database override these defaults.
# Optional persistent encryption key (32 random bytes in hex/base64), or key file.
# When omitted, data/.nhactoi-settings.key is generated with mode 0600.
# Back up that key with the database; never commit it.
NHACTOI_SETTINGS_KEY=
NHACTOI_SETTINGS_KEY_FILE=

# Illustrative pricing, VND. Annual values are the TOTAL for 12 months.
STARTER_MONTHLY_PRICE=199000
STARTER_YEARLY_PRICE=1990000
TEAM_MONTHLY_PRICE=499000
TEAM_YEARLY_PRICE=4990000
BUSINESS_MONTHLY_PRICE=999000
BUSINESS_YEARLY_PRICE=9990000

# Server checks scheduled reminders every 30 seconds.
REMINDER_INTERVAL_MS=30000
# Leave SMTP_HOST empty for in-app reminders only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
