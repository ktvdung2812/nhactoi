{
  "name": "nhactoi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:server": "NODE_OPTIONS=--max-old-space-size=512 NHACTOI_LOW_MEMORY_BUILD=1 next build --webpack",
    "start": "node --env-file-if-exists=.env node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "seed": "node --env-file-if-exists=.env server/seed.mjs",
    "test": "node --test tests/*.test.mjs",
    "admin": "node --env-file-if-exists=.env server/admin.mjs",
    "test:next": "node --test tests/integration/next-runtime.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.5",
    "nodemailer": "^10.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
