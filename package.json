{
  "name": "nhactoi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "seed": "node --env-file-if-exists=.env server/seed.mjs",
    "test": "node --test tests/*.test.mjs",
    "admin": "node --env-file-if-exists=.env server/admin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  }
}
