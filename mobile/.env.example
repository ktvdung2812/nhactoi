# Android emulator or USB device after: adb reverse tcp:3100 tcp:3100
EXPO_PUBLIC_API_URL=http://127.0.0.1:3100
# Optional: absolute path to Firebase Android app google-services.json.
# Rebuild after setting this value. FCM service credentials stay on the SERVER.
# GOOGLE_SERVICES_JSON=/absolute/private/path/google-services.json
# Production build requires HTTPS and a real backend, never the local test API.
# NHACTOI_RELEASE=1
